apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: {{ cluster_api_address | to_json }}
  bindPort: {{ cluster_api_port }}
nodeRegistration:
  name: {{ inventory_hostname | to_json }}
  criSocket: {{ cluster_cri_socket | to_json }}
  kubeletExtraArgs:
    - name: node-ip
      value: {{ ansible_host | to_json }}
  taints:
    - key: node-role.kubernetes.io/control-plane
      effect: NoSchedule
    - key: node.cilium.io/agent-not-ready
      value: "true"
      effect: NoExecute
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
clusterName: {{ cluster_name | to_json }}
kubernetesVersion: {{ ('v' ~ kubernetes_version) | to_json }}
controlPlaneEndpoint: {{ (cluster_api_address ~ ':' ~ cluster_api_port) | to_json }}
networking:
  podSubnet: {{ cluster_pod_cidr | to_json }}
  serviceSubnet: {{ cluster_service_cidr | to_json }}
  dnsDomain: {{ cluster_dns_domain | to_json }}
apiServer:
  certSANs:
    - {{ cluster_api_address | to_json }}
---
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
cgroupDriver: systemd
