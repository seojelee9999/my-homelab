apiVersion: kubeadm.k8s.io/v1beta4
kind: JoinConfiguration
discovery:
  bootstrapToken:
    apiServerEndpoint: {{ (cluster_api_address ~ ':' ~ cluster_api_port) | to_json }}
    token: {{ hostvars[cluster_control_plane].cluster_join_parts[4] | to_json }}
    caCertHashes:
      - {{ hostvars[cluster_control_plane].cluster_join_parts[6] | to_json }}
nodeRegistration:
  name: {{ inventory_hostname | to_json }}
  criSocket: {{ cluster_cri_socket | to_json }}
  kubeletExtraArgs:
    - name: node-ip
      value: {{ ansible_host | to_json }}
  taints:
    - key: node.cilium.io/agent-not-ready
      value: "true"
      effect: NoExecute
